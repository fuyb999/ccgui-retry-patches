+import { spawn as defaultSpawn } from 'node:child_process';
+import { delimiter as pathDelimiter } from 'node:path';
+import { createInterface } from 'node:readline';
+
+const CODEX_APP_SERVER_CLIENT_INFO = Object.freeze({
+  name: 'ccgui_retry_bridge',
+  title: 'CC GUI Retry Bridge',
+  version: '0.5.2-retry.7',
+});
+const TYPESCRIPT_SDK_ORIGINATOR = 'codex_sdk_ts';
+const APP_SERVER_KILL_GRACE_MS = 1_000;
+
+export const CODEX_RETRY_RECOVERY_PREFIX = [
+  '[CC GUI retry recovery]',
+  'A previous attempt may have changed external state before it failed.',
+  'Inspect the current state first and do not repeat actions that already completed.',
+].join('\n');
+
+export class CodexAppServerError extends Error {
+  constructor(message, details = {}) {
+    super(message);
+    this.name = 'CodexAppServerError';
+    this.code = 'SERVER_ERROR';
+    this.details = details;
+  }
+}
+
+function isPlainObject(value) {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function formatTomlKey(key) {
+  return /^[A-Za-z0-9_-]+$/.test(key) ? key : JSON.stringify(key);
+}
+
+function toTomlValue(value, path) {
+  if (typeof value === 'string') return JSON.stringify(value);
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) {
+      throw new CodexAppServerError('Codex App Server config is invalid', {
+        category: 'runtime',
+      });
+    }
+    return `${value}`;
+  }
+  if (typeof value === 'boolean') return value ? 'true' : 'false';
+  if (Array.isArray(value)) {
+    return `[${value.map((item, index) => toTomlValue(item, `${path}[${index}]`)).join(', ')}]`;
+  }
+  if (isPlainObject(value)) {
+    const parts = [];
+    for (const [key, child] of Object.entries(value)) {
+      if (!key) {
+        throw new CodexAppServerError('Codex App Server config is invalid', {
+          category: 'runtime',
+        });
+      }
+      if (child === undefined) continue;
+      parts.push(`${formatTomlKey(key)} = ${toTomlValue(child, `${path}.${key}`)}`);
+    }
+    return `{${parts.join(', ')}}`;
+  }
+  throw new CodexAppServerError('Codex App Server config is invalid', {
+    category: 'runtime',
+  });
+}
+
+function flattenConfigOverrides(value, prefix = '', output = []) {
+  if (!isPlainObject(value)) {
+    if (!prefix) {
+      throw new CodexAppServerError('Codex App Server config is invalid', {
+        category: 'runtime',
+      });
+    }
+    output.push(`${prefix}=${toTomlValue(value, prefix)}`);
+    return output;
+  }
+
+  const entries = Object.entries(value);
+  if (prefix && entries.length === 0) {
+    output.push(`${prefix}={}`);
+    return output;
+  }
+  for (const [key, child] of entries) {
+    if (!key) {
+      throw new CodexAppServerError('Codex App Server config is invalid', {
+        category: 'runtime',
+      });
+    }
+    if (child === undefined) continue;
+    const path = prefix ? `${prefix}.${key}` : key;
+    if (isPlainObject(child)) flattenConfigOverrides(child, path, output);
+    else output.push(`${path}=${toTomlValue(child, path)}`);
+  }
+  return output;
+}
+
+function copyEnvironment(source) {
+  const env = {};
+  for (const [key, value] of Object.entries(source || {})) {
+    if (value !== undefined) env[key] = value;
+  }
+  return env;
+}
+
+function pathEnvironmentKey(env, platform = process.platform) {
+  if (platform !== 'win32') return 'PATH';
+  const matchingKeys = Object.keys(env).filter((key) => key.toLowerCase() === 'path');
+  return matchingKeys.includes('Path') ? 'Path' : matchingKeys.at(-1) ?? 'PATH';
+}
+
+function prependPathDirectories(env, pathDirs, platform = process.platform) {
+  if (!Array.isArray(pathDirs) || pathDirs.length === 0) return;
+  const pathKey = pathEnvironmentKey(env, platform);
+  if (platform === 'win32') {
+    for (const key of Object.keys(env)) {
+      if (key.toLowerCase() === 'path' && key !== pathKey) delete env[key];
+    }
+  }
+  const existing = `${env[pathKey] ?? ''}`
+    .split(pathDelimiter)
+    .filter((entry) => entry && !pathDirs.includes(entry));
+  env[pathKey] = [...pathDirs, ...existing].join(pathDelimiter);
+}
+
+export function getCodexForkRuntime(thread) {
+  const exec = thread?._exec;
+  const options = thread?._options;
+  if (!exec || typeof exec.executablePath !== 'string' || !exec.executablePath) return null;
+  if (!Array.isArray(exec.pathDirs)) return null;
+  if (exec.configOverrides !== undefined && !isPlainObject(exec.configOverrides)) return null;
+  if (exec.envOverride !== undefined && !isPlainObject(exec.envOverride)) return null;
+
+  return {
+    executablePath: exec.executablePath,
+    pathDirs: [...exec.pathDirs],
+    envOverride: exec.envOverride === undefined
+      ? undefined
+      : { ...exec.envOverride },
+    configOverrides: exec.configOverrides,
+    baseUrl: options?.baseUrl,
+    apiKey: options?.apiKey,
+  };
+}
+
+export function buildCodexAppServerCommand(runtime) {
+  if (!runtime || typeof runtime.executablePath !== 'string' || !runtime.executablePath) {
+    throw new CodexAppServerError('Codex App Server runtime is unavailable', {
+      category: 'runtime',
+    });
+  }
+
+  const args = ['app-server', '--stdio'];
+  for (const override of flattenConfigOverrides(runtime.configOverrides || {})) {
+    args.push('--config', override);
+  }
+  if (runtime.baseUrl) {
+    args.push('--config', `openai_base_url=${toTomlValue(runtime.baseUrl, 'openai_base_url')}`);
+  }
+
+  const env = copyEnvironment(runtime.envOverride ?? process.env);
+  if (!env.CODEX_INTERNAL_ORIGINATOR_OVERRIDE) {
+    env.CODEX_INTERNAL_ORIGINATOR_OVERRIDE = TYPESCRIPT_SDK_ORIGINATOR;
+  }
+  if (runtime.apiKey) env.CODEX_API_KEY = runtime.apiKey;
+  prependPathDirectories(env, runtime.pathDirs);
+
+  return {
+    executablePath: runtime.executablePath,
+    args,
+    env,
+  };
+}
+
+function safeRpcCode(value) {
+  if (typeof value === 'number' && Number.isFinite(value)) return value;
+  if (typeof value === 'string' && /^[A-Z0-9_-]{1,64}$/i.test(value)) return value;
+  return undefined;
+}
+
+function containsMissingThreadSignal(value, seen = new Set(), depth = 0) {
+  if (typeof value === 'string') {
+    return /not[\s_-]*found|does not exist|unknown[\s_-]+thread/i.test(value);
+  }
+  if (!value || typeof value !== 'object' || depth > 4 || seen.has(value)) return false;
+  seen.add(value);
+  return Object.values(value)
+    .some((child) => containsMissingThreadSignal(child, seen, depth + 1));
+}
+
+function rpcErrorFor(method, rawError) {
+  const rpcCode = safeRpcCode(rawError?.code);
+  return new CodexAppServerError(`Codex App Server ${method} request failed`, {
+    category: 'rpc_error',
+    ...(rpcCode === undefined ? {} : { rpcCode }),
+    missingThread: containsMissingThreadSignal(rawError),
+  });
+}
+
+function protocolError(category = 'protocol') {
+  return new CodexAppServerError('Codex App Server protocol failed', { category });
+}
+
+function processError(method, code, signal) {
+  return new CodexAppServerError(`Codex App Server ${method} process failed`, {
+    category: 'process_exit',
+    ...(Number.isInteger(code) ? { exitCode: code } : {}),
+    ...(typeof signal === 'string' && /^[A-Z0-9]+$/.test(signal) ? { signal } : {}),
+  });
+}
+
+function abortReason(signal) {
+  if (signal?.reason instanceof Error) return signal.reason;
+  const error = new Error('Codex App Server request aborted');
+  error.name = 'AbortError';
+  return error;
+}
+
+function createCodexAppServerConnection({ runtime, signal, spawnImpl }) {
+  if (signal?.aborted) throw abortReason(signal);
+  const command = buildCodexAppServerCommand(runtime);
+  const detached = process.platform !== 'win32';
+  let child;
+  try {
+    child = spawnImpl(command.executablePath, command.args, {
+      env: command.env,
+      stdio: ['pipe', 'pipe', 'pipe'],
+      detached,
+    });
+  } catch {
+    throw new CodexAppServerError('Codex App Server process failed', {
+      category: 'spawn',
+    });
+  }
+
+  if (!child?.stdin || !child?.stdout) {
+    try {
+      child?.kill?.('SIGTERM');
+    } catch {
+      // The sanitized runtime error below is authoritative.
+    }
+    throw new CodexAppServerError('Codex App Server stdio is unavailable', {
+      category: 'spawn',
+    });
+  }
+
+  const lines = createInterface({ input: child.stdout, crlfDelay: Infinity });
+  child.stderr?.on?.('data', () => {
+    // Drain diagnostics without retaining potentially sensitive upstream content.
+  });
+  const completedIds = new Set();
+  let pending = null;
+  let fatalError = null;
+  let closed = child.exitCode !== null || child.signalCode !== null;
+  let resolveClosed;
+  const closedPromise = new Promise((resolve) => {
+    resolveClosed = resolve;
+  });
+  if (closed) resolveClosed();
+
+  const terminate = (terminationSignal = 'SIGTERM') => {
+    if (closed) return;
+    let groupSignalled = false;
+    if (detached && Number.isInteger(child.pid) && child.pid > 0) {
+      try {
+        process.kill(-child.pid, terminationSignal);
+        groupSignalled = true;
+      } catch {
+        groupSignalled = false;
+      }
+    }
+    if (!groupSignalled || !child.killed) {
+      try {
+        child.kill(terminationSignal);
+      } catch {
+        // The close waiter and later SIGKILL remain authoritative.
+      }
+    }
+  };
+
+  const fail = (error) => {
+    if (!fatalError) fatalError = error;
+    if (pending) {
+      const waiter = pending;
+      pending = null;
+      waiter.reject(fatalError);
+    }
+    terminate();
+  };
+
+  lines.on('line', (line) => {
+    if (!line) return;
+    let message;
+    try {
+      message = JSON.parse(line);
+    } catch {
+      fail(protocolError('malformed_json'));
+      return;
+    }
+    if (!isPlainObject(message)) {
+      fail(protocolError('malformed_response'));
+      return;
+    }
+    if (!Object.hasOwn(message, 'id')) return;
+    if (completedIds.has(message.id)) {
+      fail(protocolError('duplicate_response'));
+      return;
+    }
+    if (!pending || message.id !== pending.id) {
+      fail(protocolError('unexpected_response'));
+      return;
+    }
+    const hasResult = Object.hasOwn(message, 'result');
+    const hasError = Object.hasOwn(message, 'error');
+    if (hasResult === hasError) {
+      fail(protocolError('malformed_response'));
+      return;
+    }
+
+    const waiter = pending;
+    pending = null;
+    completedIds.add(message.id);
+    const terminalError = hasError ? rpcErrorFor(waiter.method, message.error) : null;
+    queueMicrotask(() => {
+      if (fatalError) waiter.reject(fatalError);
+      else if (terminalError) waiter.reject(terminalError);
+      else waiter.resolve(message.result);
+    });
+  });
+
+  child.once('error', () => {
+    fail(new CodexAppServerError('Codex App Server process failed', {
+      category: 'spawn',
+    }));
+  });
+  child.once('close', (code, closeSignal) => {
+    closed = true;
+    resolveClosed();
+    if (pending) fail(processError(pending.method, code, closeSignal));
+  });
+  child.stdout.on?.('error', () => fail(protocolError('stdout')));
+  child.stderr?.on?.('error', () => fail(protocolError('stderr')));
+  child.stdin.on?.('error', () => fail(protocolError('stdin')));
+
+  const onAbort = () => fail(abortReason(signal));
+  signal?.addEventListener('abort', onAbort, { once: true });
+
+  const send = (message) => {
+    if (fatalError) throw fatalError;
+    try {
+      child.stdin.write(`${JSON.stringify(message)}\n`);
+    } catch {
+      const error = protocolError('stdin');
+      fail(error);
+      throw error;
+    }
+  };
+
+  return {
+    request(id, method, params) {
+      if (fatalError) return Promise.reject(fatalError);
+      if (closed) return Promise.reject(processError(method, child.exitCode, child.signalCode));
+      if (pending || completedIds.has(id)) {
+        return Promise.reject(protocolError('request_state'));
+      }
+      const response = new Promise((resolve, reject) => {
+        pending = { id, method, resolve, reject };
+      });
+      try {
+        send({ method, id, params });
+      } catch {
+        // send() already rejected the pending request through fail().
+      }
+      return response;
+    },
+    notify(method, params) {
+      send({ method, params });
+    },
+    assertHealthy() {
+      if (fatalError) throw fatalError;
+    },
+    async close() {
+      signal?.removeEventListener('abort', onAbort);
+      try {
+        child.stdin.end();
+      } catch {
+        // Process termination remains authoritative.
+      }
+      terminate('SIGTERM');
+      if (!closed) {
+        const killTimer = setTimeout(() => terminate('SIGKILL'), APP_SERVER_KILL_GRACE_MS);
+        killTimer.unref?.();
+        await closedPromise;
+        clearTimeout(killTimer);
+      }
+      lines.close();
+    },
+  };
+}
+
+export async function requestCodexAppServer({
+  runtime,
+  method,
+  params,
+  signal,
+  spawnImpl = defaultSpawn,
+}) {
+  let connection;
+  let result;
+  let requestError = null;
+  try {
+    connection = createCodexAppServerConnection({
+      runtime,
+      signal,
+      spawnImpl,
+    });
+    await connection.request(0, 'initialize', {
+      clientInfo: CODEX_APP_SERVER_CLIENT_INFO,
+    });
+    connection.notify('initialized', {});
+    result = await connection.request(1, method, params);
+  } catch (error) {
+    requestError = error;
+  } finally {
+    await connection?.close();
+  }
+  if (requestError) throw requestError;
+  connection.assertHealthy();
+  return result;
+}
+
+export async function readCodexStableBoundary({
+  runtime,
+  sourceThreadId,
+  signal,
+  requestImpl = requestCodexAppServer,
+}) {
+  if (!sourceThreadId) return { sourceThreadId: null, lastTurnId: null };
+  const result = await requestImpl({
+    runtime,
+    method: 'thread/read',
+    params: { threadId: sourceThreadId, includeTurns: true },
+    signal,
+  });
+  if (result?.thread?.id !== sourceThreadId) {
+    throw new CodexAppServerError('Codex thread/read returned a different thread', {
+      category: 'protocol',
+    });
+  }
+  const turns = Array.isArray(result.thread.turns) ? result.thread.turns : [];
+  let lastCompletedIndex = -1;
+  for (let index = 0; index < turns.length; index += 1) {
+    const turn = turns[index];
+    if (turn?.status === 'completed' && typeof turn.id === 'string' && turn.id) {
+      lastCompletedIndex = index;
+    }
+  }
+  const lastTurnId = lastCompletedIndex >= 0 ? turns[lastCompletedIndex].id : null;
+  return {
+    sourceThreadId,
+    lastTurnId,
+    ...(lastTurnId && lastCompletedIndex < turns.length - 1 ? { requiresFork: true } : {}),
+  };
+}
+
+export function buildCodexRetryInput(runInput, hasToolActivity) {
+  if (!hasToolActivity) return runInput;
+  if (typeof runInput === 'string') {
+    return `${CODEX_RETRY_RECOVERY_PREFIX}\n\n${runInput}`;
+  }
+  if (!Array.isArray(runInput)) return runInput;
+
+  const copied = runInput.map((item) => ({ ...item }));
+  const textIndex = copied.findIndex((item) => item?.type === 'text');
+  if (textIndex < 0) {
+    return [{ type: 'text', text: CODEX_RETRY_RECOVERY_PREFIX }, ...copied];
+  }
+  copied[textIndex] = {
+    ...copied[textIndex],
+    text: `${CODEX_RETRY_RECOVERY_PREFIX}\n\n${copied[textIndex].text ?? ''}`,
+  };
+  return copied;
+}
+
+function requireDistinctChildId(childThreadId, sourceThreadId) {
+  if (
+    typeof childThreadId !== 'string'
+    || !childThreadId
+    || childThreadId === sourceThreadId
+  ) {
+    throw new CodexAppServerError('Codex thread/fork returned an invalid child thread', {
+      category: 'protocol',
+    });
+  }
+  return childThreadId;
+}
+
+function isMissingThreadError(error) {
+  return error instanceof CodexAppServerError && error.details?.missingThread === true;
+}
+
+export async function deleteCodexRetryThread({
+  runtime,
+  threadId,
+  signal,
+  requestImpl = requestCodexAppServer,
+}) {
+  if (typeof threadId !== 'string' || !threadId) {
+    throw new CodexAppServerError('Codex retry child thread is invalid', {
+      category: 'protocol',
+    });
+  }
+  try {
+    await requestImpl({
+      runtime,
+      method: 'thread/delete',
+      params: { threadId },
+      signal,
+    });
+  } catch (error) {
+    if (!isMissingThreadError(error)) throw error;
+  }
+}
+
+export async function createCodexRetryAttempt({
+  runtime,
+  codex,
+  threadOptions,
+  stableBoundary,
+  runInput,
+  hasToolActivity,
+  signal,
+  cleanupSignal,
+  requestImpl = requestCodexAppServer,
+}) {
+  const sourceThreadId = stableBoundary?.sourceThreadId ?? null;
+  const lastTurnId = stableBoundary?.lastTurnId ?? null;
+  if (sourceThreadId !== null && (typeof sourceThreadId !== 'string' || !sourceThreadId)) {
+    throw new CodexAppServerError('Codex retry source thread is invalid', {
+      category: 'protocol',
+    });
+  }
+  if (lastTurnId !== null && (typeof lastTurnId !== 'string' || !lastTurnId)) {
+    throw new CodexAppServerError('Codex retry boundary turn is invalid', {
+      category: 'protocol',
+    });
+  }
+  if (lastTurnId && !sourceThreadId) {
+    throw new CodexAppServerError('Codex retry boundary has no source thread', {
+      category: 'protocol',
+    });
+  }
+
+  let childThreadId = null;
+  if (lastTurnId) {
+    const result = await requestImpl({
+      runtime,
+      method: 'thread/fork',
+      params: { threadId: sourceThreadId, lastTurnId },
+      signal,
+    });
+    childThreadId = requireDistinctChildId(result?.thread?.id, sourceThreadId);
+  }
+
+  const retryInput = buildCodexRetryInput(runInput, hasToolActivity);
+  let eventsConsumed = false;
+  const events = {
+    async *[Symbol.asyncIterator]() {
+      if (eventsConsumed) {
+        throw new CodexAppServerError('Codex retry event stream was already consumed', {
+          category: 'protocol',
+        });
+      }
+      eventsConsumed = true;
+      const retryThread = childThreadId
+        ? codex.resumeThread(childThreadId, threadOptions)
+        : codex.startThread(threadOptions);
+      const streamed = await retryThread.runStreamed(retryInput, { signal });
+      if (!streamed?.events || typeof streamed.events[Symbol.asyncIterator] !== 'function') {
+        throw new CodexAppServerError('Codex retry SDK returned no event stream', {
+          category: 'protocol',
+        });
+      }
+      for await (const event of streamed.events) {
+        if (event?.type === 'thread.started') {
+          const eventThreadId = event.thread_id;
+          if (typeof eventThreadId !== 'string' || !eventThreadId) {
+            throw new CodexAppServerError('Codex retry SDK returned an invalid thread', {
+              category: 'protocol',
+            });
+          }
+          if (childThreadId && eventThreadId !== childThreadId) {
+            throw new CodexAppServerError('Codex retry SDK started a different thread', {
+              category: 'protocol',
+            });
+          }
+          childThreadId = eventThreadId;
+        }
+        yield event;
+      }
+    },
+  };
+
+  let cleanupComplete = false;
+  let cleanupInFlight = null;
+  const cleanup = (signalOverride = cleanupSignal) => {
+    if (cleanupComplete || !childThreadId) return Promise.resolve();
+    if (cleanupInFlight) return cleanupInFlight;
+    cleanupInFlight = deleteCodexRetryThread({
+      runtime,
+      threadId: childThreadId,
+      signal: signalOverride,
+      requestImpl,
+    }).then(() => {
+      cleanupComplete = true;
+    }).finally(() => {
+      cleanupInFlight = null;
+    });
+    return cleanupInFlight;
+  };
+
+  return {
+    events,
+    getThreadId: () => childThreadId,
+    cleanup,
+  };
+}
