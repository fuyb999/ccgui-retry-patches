+test('polls a silent SDK stream every three seconds without resetting inactivity', async () => {
+  const operationController = new AbortController();
+  const pendingTimers = new Map();
+  const processedTypes = [];
+  const retryNotices = [];
+  let nextTimerId = 1;
+  let runCalls = 0;
+  let retryAttemptCalls = 0;
+
+  const timers = {
+    setTimeout(callback, delay) {
+      const id = nextTimerId++;
+      pendingTimers.set(id, { callback, delay });
+      return id;
+    },
+    clearTimeout(id) {
+      pendingTimers.delete(id);
+    },
+  };
+  const findTimer = (delay) => {
+    for (const [id, timer] of pendingTimers) {
+      if (timer.delay === delay) return { id, ...timer };
+    }
+    return null;
+  };
+  const fireTimer = (timer) => {
+    assert.ok(timer, 'expected timer to exist');
+    pendingTimers.delete(timer.id);
+    timer.callback();
+  };
+  const flushAsyncWork = async () => {
+    await new Promise(setImmediate);
+    await new Promise(setImmediate);
+  };
+
+  const thread = {
+    id: 'source-thread',
+    async runStreamed(_input, options) {
+      runCalls += 1;
+      return {
+        events: {
+          [Symbol.asyncIterator]() {
+            return {
+              next: () => new Promise((resolve, reject) => {
+                options.signal.addEventListener('abort', () => reject(options.signal.reason), { once: true });
+              }),
+              return: async () => ({ done: true }),
+            };
+          },
+        },
+      };
+    },
+  };
+
+  const running = runCodexMessageAttempts({
+    thread,
+    runInput: 'poll silent stream',
+    state: {},
+    config: {},
+    signal: operationController.signal,
+    processEvents: async (events) => {
+      for await (const event of events) processedTypes.push(event.type);
+    },
+    inactivityTimeoutMs: 5_000,
+    inactivityTimers: timers,
+    sleep: async () => {},
+    onRetry: (notice) => retryNotices.push(notice),
+    resolveStableBoundary: resolveStableBoundary(),
+    createRetryAttempt: async () => {
+      retryAttemptCalls += 1;
+      return retryAttempt('child-1');
+    },
+  });
+
+  try {
+    await flushAsyncWork();
+    const inactivityTimer = findTimer(5_000);
+    assert.ok(inactivityTimer, 'the original inactivity deadline must be armed');
+
+    fireTimer(findTimer(3_000));
+    await flushAsyncWork();
+    assert.deepEqual(processedTypes, ['session.poll']);
+    assert.equal(findTimer(5_000)?.id, inactivityTimer.id);
+
+    fireTimer(findTimer(3_000));
+    await flushAsyncWork();
+    assert.deepEqual(processedTypes, ['session.poll', 'session.poll']);
+    assert.equal(findTimer(5_000)?.id, inactivityTimer.id);
+
+    fireTimer(inactivityTimer);
+    await running;
+  } finally {
+    operationController.abort();
+    await running.catch(() => {});
+  }
+
+  assert.equal(runCalls, 1);
+  assert.equal(retryAttemptCalls, 1);
+  assert.equal(retryNotices.length, 1);
+  assert.equal(retryNotices[0].reason.category, 'inactivity');
+});
