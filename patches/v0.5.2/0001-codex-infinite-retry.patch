+    return await withCodexInactivityTimeout(
+      Promise.resolve().then(() => cleanup(cleanupAbortController.signal)),
+      {
+        timeoutMs,
+        turnAbortController: cleanupAbortController,
+        timers,
+      },
+    );
+  } finally {
+    signal?.removeEventListener('abort', onAbort);
