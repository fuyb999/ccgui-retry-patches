+
+function normalizeStableBoundary(boundary, expectedSourceThreadId) {
+  const sourceThreadId = boundary?.sourceThreadId ?? null;
+  const lastTurnId = boundary?.lastTurnId ?? null;
+  const requiresFork = boundary?.requiresFork;
+  if (sourceThreadId !== expectedSourceThreadId) {
+    throw new CodexAppServerError('Codex stable boundary changed its source thread');
+  }
+  if (lastTurnId !== null && (typeof lastTurnId !== 'string' || !lastTurnId)) {
+    throw new CodexAppServerError('Codex stable boundary returned an invalid turn ID');
+  }
+  if (requiresFork !== undefined && typeof requiresFork !== 'boolean') {
+    throw new CodexAppServerError('Codex stable boundary returned an invalid fork requirement');
+  }
+  return Object.freeze({
+    sourceThreadId,
+    lastTurnId,
+    ...(requiresFork === true ? { requiresFork: true } : {}),
+  });
