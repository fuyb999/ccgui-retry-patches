+package com.github.claudecodegui.session;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import org.junit.Test;
+
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+public class CanonicalSessionTitleExtractorTest {
+
+    @Test
+    public void returnsTheCompleteFirstRealUserPrompt() {
+        JsonObject metaRaw = new JsonObject();
+        metaRaw.addProperty("isMeta", true);
+        JsonObject toolResultRaw = rawWithToolResult();
+        String originalPrompt = "Please investigate why the long session transport loses the original question after "
+                + "the retained tail begins and describe the smallest reliable fix.";
+
+        List<ClaudeSession.Message> messages = List.of(
+                new ClaudeSession.Message(ClaudeSession.Message.Type.USER,
+                        "<agents-instructions>injected</agents-instructions>", metaRaw),
+                new ClaudeSession.Message(ClaudeSession.Message.Type.USER, "[tool_result]", toolResultRaw),
+                new ClaudeSession.Message(ClaudeSession.Message.Type.USER, originalPrompt),
+                new ClaudeSession.Message(ClaudeSession.Message.Type.USER, "later question"));
+
+        assertEquals(originalPrompt, CanonicalSessionTitleExtractor.fromMessages(messages));
+    }
+
+    @Test
+    public void stripsInjectedBlocksWithoutTruncatingTheQuestion() {
+        ClaudeSession.Message message = new ClaudeSession.Message(
+                ClaudeSession.Message.Type.USER,
+                "<agents-instructions>ignore this injected instruction</agents-instructions>\n"
+                        + "What is the original question?");
+
+        assertEquals("What is the original question?",
+                CanonicalSessionTitleExtractor.fromMessages(List.of(message)));
+    }
+
+    @Test
+    public void allIneligibleMessagesReturnNull() {
+        JsonObject metaRaw = new JsonObject();
+        metaRaw.addProperty("isMeta", true);
+
+        List<ClaudeSession.Message> messages = List.of(
+                new ClaudeSession.Message(ClaudeSession.Message.Type.ASSISTANT, "answer"),
+                new ClaudeSession.Message(ClaudeSession.Message.Type.USER, "meta", metaRaw),
+                new ClaudeSession.Message(ClaudeSession.Message.Type.USER, "[tool_result]", rawWithToolResult()),
+                new ClaudeSession.Message(ClaudeSession.Message.Type.USER,
+                        "<system-reminder>internal only</system-reminder>"));
+
+        assertNull(CanonicalSessionTitleExtractor.fromMessages(messages));
+    }
+
+    @Test
+    public void frontendMessagesUseTheSameEligibilityRules() {
+        JsonObject frontendMessage = new JsonObject();
+        frontendMessage.addProperty("type", "user");
+        frontendMessage.addProperty("content",
+                "<system-prompt>internal only</system-prompt>\n  What should remain?  ");
+
+        assertEquals("What should remain?",
+                CanonicalSessionTitleExtractor.fromFrontendMessage(frontendMessage));
+
+        frontendMessage.add("raw", rawWithToolResult());
+        assertNull(CanonicalSessionTitleExtractor.fromFrontendMessage(frontendMessage));
+    }
+
+    private static JsonObject rawWithToolResult() {
+        JsonObject raw = new JsonObject();
+        JsonArray content = new JsonArray();
+        JsonObject toolResult = new JsonObject();
+        toolResult.addProperty("type", "tool_result");
+        toolResult.addProperty("tool_use_id", "synthetic-tool-id");
+        toolResult.addProperty("content", "synthetic result");
+        content.add(toolResult);
+        raw.add("content", content);
+        return raw;
+    }
+}
