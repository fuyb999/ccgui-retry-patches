 /**
  * Verifies usage values crossing the session callback JavaScript bridge are safe.
  */
 public class SessionCallbackAdapterUsageTest {
 
+    @Test
+    public void retryStateIsRetainedUntilVisibleActivity() {
+        RecordingJsTarget target = new RecordingJsTarget();
+        SessionCallbackAdapter adapter = new SessionCallbackAdapter(
+                null, target, null, () -> true, null);
+
+        String scheduled = "{\"phase\":\"scheduled\",\"retryCount\":1}";
+        adapter.onCodexRetryState(scheduled);
+        assertEquals(scheduled, adapter.getRetainedCodexRetryState());
+
+        String started = "{\"phase\":\"attempt_started\",\"retryCount\":1}";
+        adapter.onCodexRetryState(started);
+        assertEquals(started, adapter.getRetainedCodexRetryState());
+        assertTrue(target.calls.stream().anyMatch(call -> call.startsWith("onCodexRetryState:")));
+
+        adapter.onContentDelta("visible output");
+        assertEquals(null, adapter.getRetainedCodexRetryState());
+
+        adapter.onCodexRetryState(scheduled);
+        adapter.clearRetainedCodexRetryState();
+        assertEquals(null, adapter.getRetainedCodexRetryState());
+    }
+
+    @Test
+    public void historyAndEmptyAssistantSnapshotDoNotClearRetryState() {
+        StreamMessageCoalescer coalescer = new StreamMessageCoalescer(new DisposedCoalescerTarget());
+        SessionCallbackAdapter adapter = new SessionCallbackAdapter(
+                coalescer, new RecordingJsTarget(), null, () -> true, null);
+        try {
+            ClaudeSession.Message emptyAssistant = new ClaudeSession.Message(
+                    ClaudeSession.Message.Type.ASSISTANT, "", assistantRaw(new JsonArray()));
+            List<ClaudeSession.Message> messages = new ArrayList<>(List.of(
+                    new ClaudeSession.Message(ClaudeSession.Message.Type.USER, "earlier prompt"),
+                    new ClaudeSession.Message(ClaudeSession.Message.Type.ASSISTANT, "earlier response"),
+                    new ClaudeSession.Message(ClaudeSession.Message.Type.USER, "current prompt"),
+                    emptyAssistant
+            ));
+
+            String started = "{\"phase\":\"attempt_started\",\"retryCount\":1}";
+            adapter.onCodexRetryState(started);
+            adapter.onMessageUpdate(messages);
+            assertEquals(started, adapter.getRetainedCodexRetryState());
+
+            JsonArray blocks = new JsonArray();
+            JsonObject toolUse = new JsonObject();
+            toolUse.addProperty("type", "tool_use");
+            toolUse.addProperty("id", "tool-1");
+            toolUse.addProperty("name", "Bash");
+            blocks.add(toolUse);
+            emptyAssistant.raw = assistantRaw(blocks);
+            adapter.onMessageUpdate(messages);
+            assertEquals(null, adapter.getRetainedCodexRetryState());
+        } finally {
+            coalescer.dispose();
+        }
+    }
+
+    private static JsonObject assistantRaw(JsonArray blocks) {
+        JsonObject message = new JsonObject();
+        message.add("content", blocks);
+        JsonObject raw = new JsonObject();
+        raw.addProperty("type", "assistant");
+        raw.add("message", message);
+        return raw;
+    }
+
+    private static final class DisposedCoalescerTarget implements StreamMessageCoalescer.JsCallbackTarget {
+        @Override public void callJavaScript(String functionName, String... args) {}
+        @Override public JBCefBrowser getBrowser() { return null; }
+        @Override public boolean isDisposed() { return true; }
+        @Override public HandlerContext getHandlerContext() { return null; }
+    }
+
+    private static final class RecordingJsTarget implements SessionCallbackAdapter.JsTarget {
+        final List<String> calls = new ArrayList<>();
+
+        @Override
+        public void callJavaScript(String functionName, String... args) {
+            calls.add(functionName + ":" + (args.length > 0 ? args[0] : ""));
+        }
+    }
