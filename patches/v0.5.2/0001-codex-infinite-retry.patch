+function withCodexEventInactivityWatchdog(events, options) {
+  if (!events || typeof events[Symbol.asyncIterator] !== 'function') return events;
+
+  return {
+    async *[Symbol.asyncIterator]() {
+      const iterator = events[Symbol.asyncIterator]();
+      const pollIntervalMs = options?.pollIntervalMs ?? CODEX_SESSION_POLL_INTERVAL_MS;
+      const pollTimers = options?.timers ?? globalThis;
+      let pendingNext = null;
+      try {
+        while (true) {
+          if (!pendingNext) {
+            pendingNext = withCodexInactivityTimeout(iterator.next(), options)
+              .then((result) => ({ kind: 'event', result }));
+          }
+          const pollWait = createSessionPollWait(pollIntervalMs, pollTimers);
+          let outcome;
+          try {
+            outcome = await Promise.race([pendingNext, pollWait.promise]);
+          } finally {
+            pollWait.cancel();
+          }
+          if (outcome.kind === 'poll') {
+            yield { type: 'session.poll' };
+            continue;
+          }
+          pendingNext = null;
+          const { result } = outcome;
+          if (result.done) return;
+          yield result.value;
+        }
+      } finally {
+        const closing = iterator.return?.();
+        closing?.catch?.(() => {});
+      }
+    },
+  };
+}
