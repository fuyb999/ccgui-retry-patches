+package com.github.claudecodegui.session;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.util.List;
+import java.util.regex.Pattern;
+
+/**
+ * Selects the first user-authored question suitable for a session title.
+ */
+public final class CanonicalSessionTitleExtractor {
+
+    private static final Pattern INJECTED_BLOCKS = Pattern.compile(
+            "(?is)<(agents-instructions|system-reminder|system-prompt|local-command-caveat)\\b[^>]*>.*?</\\1\\s*>");
+
+    private CanonicalSessionTitleExtractor() {
+    }
+
+    static String fromMessages(List<ClaudeSession.Message> messages) {
+        if (messages == null) {
+            return null;
+        }
+        for (ClaudeSession.Message message : messages) {
+            String prompt = fromMessage(message);
+            if (prompt != null) {
+                return prompt;
+            }
+        }
+        return null;
+    }
+
+    public static String fromFrontendMessage(JsonObject frontendMessage) {
+        if (frontendMessage == null
+                || !hasStringValue(frontendMessage, "type", "user")) {
+            return null;
+        }
+        JsonObject raw = objectValue(frontendMessage, "raw");
+        String content = stringValue(frontendMessage, "content");
+        return fromUserContent(content, raw);
+    }
+
+    private static String fromMessage(ClaudeSession.Message message) {
+        if (message == null || message.type != ClaudeSession.Message.Type.USER) {
+            return null;
+        }
+        return fromUserContent(message.content, message.raw);
+    }
+
+    private static String fromUserContent(String content, JsonObject raw) {
+        if (isMeta(raw) || "[tool_result]".equals(content) || containsToolResult(raw)) {
+            return null;
+        }
+        if (content == null) {
+            return null;
+        }
+
+        String normalized = INJECTED_BLOCKS.matcher(content).replaceAll("")
+                .replaceAll("\\s+", " ")
+                .trim();
+        if (normalized.isEmpty() || normalized.startsWith("<")) {
+            return null;
+        }
+        return normalized;
+    }
+
+    private static boolean isMeta(JsonObject raw) {
+        return raw != null
+                && raw.has("isMeta")
+                && !raw.get("isMeta").isJsonNull()
+                && raw.get("isMeta").isJsonPrimitive()
+                && raw.get("isMeta").getAsBoolean();
+    }
+
+    private static boolean containsToolResult(JsonObject raw) {
+        return raw != null
+                && (contentContainsToolResult(raw.get("content"))
+                || (raw.has("message") && raw.get("message").isJsonObject()
+                && contentContainsToolResult(raw.getAsJsonObject("message").get("content"))));
+    }
+
+    private static boolean contentContainsToolResult(JsonElement content) {
+        if (content == null || !content.isJsonArray()) {
+            return false;
+        }
+        JsonArray blocks = content.getAsJsonArray();
+        for (JsonElement block : blocks) {
+            if (block.isJsonObject() && hasStringValue(block.getAsJsonObject(), "type", "tool_result")) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static JsonObject objectValue(JsonObject object, String name) {
+        return object.has(name) && object.get(name).isJsonObject()
+                ? object.getAsJsonObject(name) : null;
+    }
+
+    private static String stringValue(JsonObject object, String name) {
+        return object.has(name)
+                && !object.get(name).isJsonNull()
+                && object.get(name).isJsonPrimitive()
+                && object.get(name).getAsJsonPrimitive().isString()
+                ? object.get(name).getAsString() : null;
+    }
+
+    private static boolean hasStringValue(JsonObject object, String name, String expected) {
+        return expected.equals(stringValue(object, name));
+    }
+}
