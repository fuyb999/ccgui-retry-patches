+import { act, render, screen } from '@testing-library/react';
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest';
+import WaitingIndicator from './WaitingIndicator';
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (key: string, values?: Record<string, unknown>) => {
+      if (key === 'chat.retryingResponse') return `Retry ${values?.retryCount}`;
+      if (key === 'chat.retryReason') return `Reason: ${values?.reason}`;
+      if (key === 'chat.retryCountdown') return `${values?.seconds}s`;
+      if (key === 'chat.codexRunning') return 'Codex is running; waiting for output';
+      if (key === 'chat.retryAttemptRunning') return `Retry attempt ${values?.retryCount} is running; waiting for Codex output`;
+      if (key === 'chat.generatingResponse') return 'Generating response';
+      if (key === 'chat.elapsedTime') return `Elapsed ${values?.time}`;
+      if (key === 'common.seconds') return 's';
+      return key;
+    },
+  }),
+}));
+
+describe('WaitingIndicator retry progress', () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date('2026-08-13T00:00:00.000Z'));
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it('shows retry number, safe reason, and a countdown that updates every second', () => {
+    render(<WaitingIndicator retryState={{
+      phase: 'scheduled',
+      retryCount: 3,
+      delayMs: 30000,
+      retryAt: Date.now() + 30000,
+      reason: { category: 'http_5xx', status: 503, code: 'SERVER_ERROR' },
+    }} />);
+
+    expect(screen.getByText('Retry 3')).toBeTruthy();
+    expect(screen.getByText('Reason: SERVER_ERROR')).toBeTruthy();
+    expect(screen.getByText('30s')).toBeTruthy();
+
+    act(() => {
+      vi.advanceTimersByTime(1000);
+    });
+    expect(screen.getByText('29s')).toBeTruthy();
+  });
+
+  it('owns and cleans up a dedicated retry countdown timer', () => {
+    const { unmount } = render(<WaitingIndicator retryState={{
+      phase: 'scheduled',
+      retryCount: 1,
+      delayMs: 30000,
+      retryAt: Date.now() + 30000,
+      reason: { category: 'rate_limit', status: 429 },
+    }} />);
+
+    expect(vi.getTimerCount()).toBe(3);
+    unmount();
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('keeps the ordinary loading label when no retry is scheduled', () => {
+    render(<WaitingIndicator />);
+    expect(screen.getByText(/Generating response/)).toBeTruthy();
+  });
+
+  it('shows that the initial Codex attempt is running until output arrives', () => {
+    render(<WaitingIndicator retryState={{
+      phase: 'attempt_started',
+      retryCount: 0,
+    }} />);
+
+    expect(screen.getByText(/Codex is running; waiting for output/)).toBeTruthy();
+  });
+
+  it('keeps a started retry distinct from ordinary loading', () => {
+    render(<WaitingIndicator retryState={{
+      phase: 'attempt_started',
+      retryCount: 2,
+    }} />);
+
+    expect(screen.getByText(/Retry attempt 2 is running; waiting for Codex output/)).toBeTruthy();
+  });
+});
