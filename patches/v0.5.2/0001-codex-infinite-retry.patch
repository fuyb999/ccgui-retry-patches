+import { cleanup, render, screen } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { RetryStatusStrip } from './RetryStatusStrip';
+
+vi.mock('./WaitingIndicator', () => ({
+  default: ({ variant }: { variant?: 'inline' | 'status' }) => (
+    <div data-testid="waiting-indicator" data-variant={variant}>waiting</div>
+  ),
+}));
+
+describe('RetryStatusStrip', () => {
+  afterEach(cleanup);
+
+  it('renders positive retry counts as a polite status strip', () => {
+    render(
+      <RetryStatusStrip
+        retryState={{
+          phase: 'scheduled',
+          retryCount: 1,
+          retryAt: Date.now() + 1_000,
+          reason: { category: 'http_5xx', status: 503 },
+        }}
+      />,
+    );
+
+    const status = screen.getByRole('status');
+    expect(status.classList.contains('codex-retry-status')).toBe(true);
+    expect(screen.getByTestId('waiting-indicator').getAttribute('data-variant')).toBe('status');
+  });
+
+  it('does not render a status for the initial attempt', () => {
+    render(
+      <RetryStatusStrip
+        retryState={{
+          phase: 'attempt_started',
+          retryCount: 0,
+        }}
+      />,
+    );
+
+    expect(screen.queryByRole('status')).toBeNull();
+  });
+});
