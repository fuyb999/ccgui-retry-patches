+  if (!events || typeof events[Symbol.asyncIterator] !== 'function') return events;
+  return {
+    async *[Symbol.asyncIterator]() {
+      for await (const event of events) {
+        if (event?.type === 'thread.started' && typeof event.thread_id === 'string' && event.thread_id) {
