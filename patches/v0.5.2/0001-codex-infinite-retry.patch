+    Promise.resolve().then(() => operationFactory(turnAbortController.signal)),
+    { timeoutMs, turnAbortController, timers },
+  );
+}
+
+async function withCleanupOperationTimeout(cleanup, {
+  signal,
+  timeoutMs,
+  timers,
+}) {
+  const cleanupAbortController = new AbortController();
+  const onAbort = () => cleanupAbortController.abort(signal.reason);
+  if (signal?.aborted) onAbort();
+  else signal?.addEventListener('abort', onAbort, { once: true });
