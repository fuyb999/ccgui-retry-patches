+import { fireEvent, render, screen } from '@testing-library/react';
+import type { TFunction } from 'i18next';
+import { describe, expect, it, vi } from 'vitest';
+
+import { ChatHeader } from './ChatHeader';
+
+describe('ChatHeader', () => {
+  it('shows, edits, and saves the complete session title', () => {
+    const fullTitle =
+      'A complete session title that is intentionally longer than fifty characters';
+    const replacement = `${fullTitle} with additional complete text`;
+    const onTitleChange = vi.fn();
+    const t = ((key: string) => key) as TFunction;
+
+    render(<ChatHeader
+      currentView="chat"
+      sessionTitle={fullTitle}
+      t={t}
+      onBack={vi.fn()}
+      onNewSession={vi.fn()}
+      onNewTab={vi.fn()}
+      onHistory={vi.fn()}
+      onSettings={vi.fn()}
+      onTitleChange={onTitleChange}
+      titleEditable
+    />);
+
+    expect(screen.getByText(fullTitle).getAttribute('title')).toBe(fullTitle);
+    fireEvent.click(screen.getByRole('button', { name: 'Edit session title' }));
+    expect((screen.getByRole('textbox', { name: 'Session title' }) as HTMLInputElement).value)
+      .toBe(fullTitle);
+
+    fireEvent.change(screen.getByRole('textbox', { name: 'Session title' }), {
+      target: { value: replacement },
+    });
+    fireEvent.click(screen.getByRole('button', { name: 'Save title' }));
+
+    expect(onTitleChange).toHaveBeenCalledWith(replacement);
+  });
+});
