+export const CODEX_RETRY_DELAY_MS = 30_000;
+export const CODEX_INACTIVITY_TIMEOUT_MS = 600_000;
+export const CODEX_INACTIVITY_TIMEOUT_CODE = 'CODEX_STREAM_INACTIVITY_TIMEOUT';
+
+const NETWORK_ERROR_CODES = new Set([
+  'ECONNRESET',
+  'ECONNREFUSED',
+  'EPIPE',
+  'ETIMEDOUT',
+  'ENETDOWN',
+  'ENETRESET',
+  'ENETUNREACH',
+  'EHOSTDOWN',
+  'EHOSTUNREACH',
+  'ENOTFOUND',
+  'EAI_AGAIN',
+  'UND_ERR_CONNECT_TIMEOUT',
+  'UND_ERR_HEADERS_TIMEOUT',
+  'UND_ERR_BODY_TIMEOUT',
+  'UND_ERR_SOCKET',
+  CODEX_INACTIVITY_TIMEOUT_CODE,
+]);
+
+const DAILY_LIMIT_CODES = new Set([
+  'DAYLY_LIMIT_EXCEEDED',
+  'DAILY_LIMIT_EXCEEDED',
+  'DAILY_USAGE_LIMIT_EXCEEDED',
+]);
+
+const SAFE_RETRY_CODES = new Set([
+  ...NETWORK_ERROR_CODES,
+  'MODEL_AT_CAPACITY',
+  'RATE_LIMIT_EXCEEDED',
+  'SERVER_ERROR',
+  'INTERNAL_SERVER_ERROR',
+  'SERVICE_UNAVAILABLE',
+  'BAD_GATEWAY',
+  'GATEWAY_TIMEOUT',
+]);
+
+export class CodexInactivityTimeoutError extends Error {
+  constructor(timeoutMs) {
+    super(`Codex SDK stream produced no events for ${timeoutMs}ms`);
+    this.name = 'CodexInactivityTimeoutError';
+    this.code = CODEX_INACTIVITY_TIMEOUT_CODE;
+    this.timeoutMs = timeoutMs;
+  }
+}
+
+export class CodexTurnFailure extends Error {
+  constructor(message, details) {
+    super(message, details instanceof Error ? { cause: details } : undefined);
+    this.name = 'CodexTurnFailure';
+    this.details = details;
+  }
+}
+
+export function resolveCodexInactivityTimeoutMs(value) {
+  const parsed = typeof value === 'number' ? value : Number(value);
+  return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : CODEX_INACTIVITY_TIMEOUT_MS;
+}
+
+function numericStatus(value) {
+  if (typeof value === 'number' && Number.isInteger(value) && value >= 100 && value <= 599) return value;
+  if (typeof value === 'string' && /^\d{3}$/.test(value.trim())) {
+    const parsed = Number(value);
+    if (parsed >= 100 && parsed <= 599) return parsed;
+  }
+  return null;
+}
+
+function normalizeErrorIdentifier(value) {
+  if (typeof value !== 'string') return null;
+  const normalized = value
+    .trim()
+    .toUpperCase()
+    .replace(/[\u2010-\u2015\u2212\uFE58\uFE63\uFF0D.\s-]+/g, '_')
+    .replace(/^_+|_+$/g, '');
+  return normalized || null;
+}
+
+function collectErrorEvidence(root) {
+  const statuses = new Set();
+  const codes = new Set();
+  const reasons = new Set();
+  const messages = [];
+  const seen = new Set();
+  const pending = [root];
+
+  while (pending.length > 0) {
+    const value = pending.pop();
+    if (value == null) continue;
+    if (typeof value === 'string') {
+      messages.push(value);
+      continue;
+    }
+    if (typeof value !== 'object' || seen.has(value)) continue;
+    seen.add(value);
+
+    for (const key of ['status', 'statusCode', 'httpStatus', 'http_status']) {
+      const status = numericStatus(value[key]);
+      if (status !== null) statuses.add(status);
+    }
+
+    for (const key of ['code', 'type']) {
+      const code = normalizeErrorIdentifier(value[key]);
+      if (code) codes.add(code);
+    }
+    const reason = normalizeErrorIdentifier(value.reason);
+    if (reason) reasons.add(reason);
+    if (typeof value.message === 'string') messages.push(value.message);
+
+    for (const key of ['error', 'cause', 'details', 'response']) {
+      if (value[key] != null) pending.push(value[key]);
+    }
+  }
+
+  const combinedMessage = messages.join('\n');
+  const bareStatus = numericStatus(combinedMessage.trim());
+  if (bareStatus !== null) statuses.add(bareStatus);
+  for (const match of combinedMessage.matchAll(/^\s*(\d{3})(?=\s|:|$)/gm)) {
+    const status = numericStatus(match[1]);
+    if (status !== null) statuses.add(status);
+  }
+  for (const match of combinedMessage.matchAll(/\b(?:http(?:\s+status)?|status(?:\s+code)?)[\s:=]*(\d{3})\b/gi)) {
+    statuses.add(Number(match[1]));
+  }
+  return { statuses, codes, reasons, message: combinedMessage };
+}
+
+function isDailyUsageLimit({ codes, reasons, message }) {
+  return [...codes, ...reasons].some((value) => DAILY_LIMIT_CODES.has(value)) ||
+    /\bdaily\s+usage\s+limit\s+exceeded\b/i.test(message);
+}
+
+function selectRetryStatus(statuses) {
+  if (statuses.has(429)) return 429;
+  return [...statuses].find((status) => status >= 500 && status <= 599) ?? null;
+}
+
+function selectRetryCode(codes) {
+  const code = [...codes].find((value) => SAFE_RETRY_CODES.has(value));
+  return code || null;
+}
+
+export function buildCodexRetryReason(error) {
+  const { statuses, codes, message } = collectErrorEvidence(error);
+  const status = selectRetryStatus(statuses);
+  const code = selectRetryCode(codes);
+  let category = 'retryable_error';
+
+  if (codes.has(CODEX_INACTIVITY_TIMEOUT_CODE)) {
+    category = 'inactivity';
+  } else if (codes.has('MODEL_AT_CAPACITY') ||
+      /selected model is at capacity|model[_\s-]?at[_\s-]?capacity/i.test(message)) {
+    category = 'capacity';
+  } else if (status === 429 || codes.has('RATE_LIMIT_EXCEEDED') ||
+      /\btoo many requests\b|\brate limit(?:ed| exceeded)?\b/i.test(message)) {
+    category = 'rate_limit';
+  } else if (status !== null && status >= 500 && status <= 599) {
+    category = 'http_5xx';
+  } else if ([...codes].some((value) => NETWORK_ERROR_CODES.has(value)) ||
+      /\bfetch failed\b|\bnetwork error\b|socket (?:closed|hang up)|connection (?:reset|refused|closed|terminated)|premature (?:eof|stream|closure)|stream (?:ended|closed|terminated) (?:early|unexpectedly)|dns (?:lookup )?fail|timed? out/i.test(message)) {
+    category = 'network';
+  }
+
+  return {
+    category,
+    ...(status !== null ? { status } : {}),
+    ...(code ? { code } : {}),
+  };
+}
+
+export function isRetryableCodexError(error) {
+  const evidence = collectErrorEvidence(error);
+  const { statuses, codes, message } = evidence;
+  if (isDailyUsageLimit(evidence)) return false;
+  if (statuses.has(429) || [...statuses].some((status) => status >= 500 && status <= 599)) return true;
+  if (statuses.size > 0) return false;
+  if ([...codes].some((code) => SAFE_RETRY_CODES.has(code))) return true;
+
+  return /selected model is at capacity|model[_\s-]?at[_\s-]?capacity|\btoo many requests\b|\brate limit(?:ed| exceeded)?\b/i.test(message) ||
+    /\bfetch failed\b|\bnetwork error\b|socket (?:closed|hang up)|connection (?:reset|refused|closed|terminated)|premature (?:eof|stream|closure)|stream (?:ended|closed|terminated) (?:early|unexpectedly)|dns (?:lookup )?fail|timed? out/i.test(message);
+}
+
+function createAbortError(signal) {
+  const error = new Error('Codex retry cancelled', signal?.reason ? { cause: signal.reason } : undefined);
+  error.name = 'AbortError';
+  return error;
+}
+
+export function abortableDelay(ms, signal, timers = globalThis) {
+  if (signal?.aborted) return Promise.reject(createAbortError(signal));
+
+  return new Promise((resolve, reject) => {
+    let timer;
+    const cleanup = () => signal?.removeEventListener('abort', onAbort);
+    const onAbort = () => {
+      timers.clearTimeout(timer);
+      cleanup();
+      reject(createAbortError(signal));
+    };
+    timer = timers.setTimeout(() => {
+      cleanup();
+      resolve();
+    }, ms);
+    signal?.addEventListener('abort', onAbort, { once: true });
+  });
+}
+
+export function withCodexInactivityTimeout(operation, {
+  timeoutMs = CODEX_INACTIVITY_TIMEOUT_MS,
+  turnAbortController,
+  timers = globalThis,
+} = {}) {
+  const resolvedTimeoutMs = resolveCodexInactivityTimeoutMs(timeoutMs);
+  let timer;
+  const timeout = new Promise((resolve, reject) => {
+    timer = timers.setTimeout(() => {
+      const error = new CodexInactivityTimeoutError(resolvedTimeoutMs);
+      turnAbortController?.abort(error);
+      reject(error);
+    }, resolvedTimeoutMs);
+  });
+
+  return Promise.race([Promise.resolve(operation), timeout])
+    .finally(() => timers.clearTimeout(timer));
+}
+
+export function resetCodexAttemptState(state) {
+  if (!state || typeof state !== 'object') return;
+  state.turnStarted = false;
+  state.turnCompleted = false;
+  state.turnUsageBaseline = null;
+  state.latestTotalTokenUsage = null;
+  state.commandApprovalAbortRequested = false;
+}
+
+function linkAbortSignal(signal, turnAbortController) {
+  if (!signal) return () => {};
+  const abortAttempt = () => turnAbortController.abort(signal.reason);
+  if (signal.aborted) abortAttempt();
+  else signal.addEventListener('abort', abortAttempt, { once: true });
+  return () => signal.removeEventListener('abort', abortAttempt);
+}
+
+export async function runCodexTurnWithRetry({
+  state,
+  signal,
+  runAttempt,
+  sleep = abortableDelay,
+  onRetry,
+  onAttemptStart,
+  now = Date.now,
+}) {
+  if (typeof runAttempt !== 'function') throw new TypeError('runAttempt must be a function');
+  let retryCount = 0;
+
+  while (true) {
+    if (signal?.aborted) throw createAbortError(signal);
+    if (retryCount > 0) onAttemptStart?.({ retryCount });
+    const turnAbortController = new AbortController();
+    const unlinkAbortSignal = linkAbortSignal(signal, turnAbortController);
+    try {
+      return await runAttempt({ turnAbortController, retryCount });
+    } catch (error) {
+      const attemptAbortReason = turnAbortController.signal.reason;
+      const inactivityError = attemptAbortReason?.code === CODEX_INACTIVITY_TIMEOUT_CODE
+        ? attemptAbortReason
+        : error?.code === CODEX_INACTIVITY_TIMEOUT_CODE ? error : null;
+      const retryError = inactivityError || error;
+      if (
+        signal?.aborted ||
+        (turnAbortController.signal.aborted && !inactivityError) ||
+        state?.turnCompleted ||
+        !isRetryableCodexError(retryError)
+      ) {
+        throw error;
+      }
+      retryCount += 1;
+      onRetry?.({
+        error: retryError,
+        retryCount,
+        delayMs: CODEX_RETRY_DELAY_MS,
+        retryAt: now() + CODEX_RETRY_DELAY_MS,
+        reason: buildCodexRetryReason(retryError),
+      });
+      await sleep(CODEX_RETRY_DELAY_MS, signal);
+      resetCodexAttemptState(state);
+    } finally {
+      unlinkAbortSignal();
+    }
+  }
+}
