+
+function createAppServerHarness(handleMessage, {
+  autoCloseOnEnd = true,
+  handleEnd,
+} = {}) {
+  const spawnCalls = [];
+  const sent = [];
+  const children = [];
+
+  const spawnImpl = (command, args, options) => {
+    const child = new EventEmitter();
+    child.pid = 900_000 + children.length;
+    child.exitCode = null;
+    child.signalCode = null;
+    child.killed = false;
+    child.stdout = new PassThrough();
+    child.stderr = new PassThrough();
+    let inputBuffer = '';
+    let closed = false;
+
+    const close = (code = 0, signal = null) => {
+      if (closed) return;
+      closed = true;
+      child.exitCode = code;
+      child.signalCode = signal;
+      queueMicrotask(() => child.emit('close', code, signal));
+    };
+    const send = (message) => {
+      child.stdout.write(`${JSON.stringify(message)}\n`);
+    };
+    const sendRaw = (line) => {
+      child.stdout.write(`${line}\n`);
+    };
+
+    child.stdin = {
+      destroyed: false,
+      writableEnded: false,
+      write(chunk) {
+        inputBuffer += chunk.toString();
+        while (inputBuffer.includes('\n')) {
+          const newline = inputBuffer.indexOf('\n');
+          const line = inputBuffer.slice(0, newline);
+          inputBuffer = inputBuffer.slice(newline + 1);
+          if (!line) continue;
+          const message = JSON.parse(line);
+          sent.push(message);
+          handleMessage?.({ message, send, sendRaw, close, child, sent });
+        }
+        return true;
+      },
+      end() {
+        this.writableEnded = true;
+        handleEnd?.({ send, sendRaw, close, child, sent });
+        if (autoCloseOnEnd) close(0, null);
+      },
+      destroy() {
+        this.destroyed = true;
+      },
+    };
+    child.kill = (signal = 'SIGTERM') => {
+      child.killed = true;
+      close(null, signal);
+      return true;
+    };
+
+    spawnCalls.push({ command, args, options });
+    children.push(child);
+    return child;
+  };
+
+  return { spawnImpl, spawnCalls, sent, children };
+}
+
+function successfulHarness(resultForRequest = {}) {
+  return createAppServerHarness(({ message, send }) => {
+    if (message.method === 'initialize') send({ id: message.id, result: {} });
+    else if (Object.hasOwn(message, 'id')) send({ id: message.id, result: resultForRequest });
+  });
+}
+
+async function collectEvents(events) {
+  const collected = [];
+  for await (const event of events) collected.push(event);
+  return collected;
+}
+
