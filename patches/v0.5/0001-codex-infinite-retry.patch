  +export class CodexTurnFailure extends Error {
  +  constructor(message, details) {
  +    super(message, details instanceof Error ? { cause: details } : undefined);
  +    this.name = 'CodexTurnFailure';
  +    this.details = details;
  +  }
  +}
  +
  +function numericStatus(value) {
  +  if (typeof value === 'number' && Number.isInteger(value)) return value;
  +  if (typeof value === 'string' && /^\d{3}$/.test(value.trim())) return Number(value);
  +  return null;
  +}
  +
  +function collectErrorEvidence(root) {
  +  const statuses = new Set();
  +  const codes = new Set();
  +  const messages = [];
  +  const seen = new Set();
