+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { runCodexMessageAttempts } from './message-service.js';
+import { CodexTurnFailure } from './codex-retry.js';
+
+test('keeps one logical stream open across a retry and reuses the thread input', async () => {
+  const runCalls = [];
+  const attemptControllers = [];
+  const retryNotices = [];
+  const replayBoundaries = [];
+  let streamStarts = 0;
+  let streamEnds = 0;
+  let processCalls = 0;
+  const runInput = [{ type: 'text', text: 'continue this task' }];
+  const state = { currentThreadId: 'thread-1' };
+  const thread = {
+    async runStreamed(input, options) {
+      runCalls.push(input);
+      attemptControllers.push(options.signal);
+      return { events: { attempt: runCalls.length } };
+    },
+  };
+
+  await runCodexMessageAttempts({
+    thread,
+    runInput,
+    state,
+    config: { onTurnCompleted: () => { streamEnds += 1; } },
+    processEvents: async (events, receivedState, config) => {
+      processCalls += 1;
+      assert.equal(receivedState, state);
+      assert.equal(events.attempt, processCalls);
+      assert.equal(config.turnAbortController.signal, attemptControllers.at(-1));
+      if (processCalls === 1) {
+        throw new CodexTurnFailure('HTTP 503', { status: 503 });
+      }
+      config.onTurnCompleted();
+    },
+    sleep: async (ms) => assert.equal(ms, 30_000),
+    onStreamStart: () => { streamStarts += 1; },
+    onRetry: (notice) => retryNotices.push(notice),
+    prepareReplayBoundary: async (receivedState, threadId) => {
+      assert.equal(receivedState, state);
+      replayBoundaries.push(threadId);
+    },
+  });
+
+  assert.equal(runCalls.length, 2);
+  assert.equal(runCalls[0], runInput);
+  assert.equal(runCalls[1], runInput);
+  assert.notEqual(attemptControllers[0], attemptControllers[1]);
+  assert.equal(streamStarts, 1);
+  assert.equal(streamEnds, 1);
+  assert.equal(retryNotices.length, 1);
+  assert.deepEqual(replayBoundaries, ['thread-1']);
+  assert.equal(state.currentThreadId, 'thread-1');
+});
+
+test('retries a transport failure thrown before event processing starts', async () => {
+  let runCalls = 0;
+  let processCalls = 0;
+  let streamStarts = 0;
+  const thread = {
+    async runStreamed() {
+      runCalls += 1;
+      if (runCalls === 1) throw Object.assign(new Error('fetch failed'), { code: 'ECONNREFUSED' });
+      return { events: [] };
+    },
+  };
+
+  await runCodexMessageAttempts({
+    thread,
+    runInput: 'retry me',
+    state: {},
+    config: {},
+    processEvents: async () => { processCalls += 1; },
+    sleep: async () => {},
+    onStreamStart: () => { streamStarts += 1; },
+  });
+
+  assert.equal(runCalls, 2);
+  assert.equal(processCalls, 1);
+  assert.equal(streamStarts, 1);
+});
+
+test('retries when the SDK event iterator remains inactive', async () => {
+  const delays = [];
+  const retryNotices = [];
+  const timerDelays = [];
+  const pendingTimers = new Map();
+  let nextTimerId = 1;
+  let runCalls = 0;
+  let firstAttemptSignal;
+  const timers = {
+    setTimeout(callback, delay) {
+      const id = nextTimerId++;
+      timerDelays.push(delay);
+      pendingTimers.set(id, callback);
+      return id;
+    },
+    clearTimeout(id) {
+      pendingTimers.delete(id);
+    },
+  };
+  const thread = {
+    async runStreamed(_input, options) {
+      runCalls += 1;
+      if (runCalls === 1) {
+        firstAttemptSignal = options.signal;
+        return {
+          events: {
+            [Symbol.asyncIterator]() {
+              return {
+                next: () => new Promise((resolve, reject) => {
+                  options.signal.addEventListener('abort', () => reject(options.signal.reason), { once: true });
+                }),
+                return: async () => ({ done: true }),
+              };
+            },
+          },
+        };
+      }
+      return {
+        events: {
+          async *[Symbol.asyncIterator]() {
+            yield { type: 'turn.started' };
+          },
+        },
+      };
+    },
+  };
+
+  const running = runCodexMessageAttempts({
+    thread,
+    runInput: 'retry inactive stream',
+    state: {},
+    config: {},
+    processEvents: async (events) => {
+      for await (const _event of events) {
+        // Consuming the iterable is the behavior under test.
+      }
+    },
+    inactivityTimeoutMs: 5_000,
+    inactivityTimers: timers,
+    sleep: async (ms) => delays.push(ms),
+    onRetry: (notice) => retryNotices.push(notice),
+  });
+
+  await new Promise(setImmediate);
+  assert.equal(runCalls, 1);
+  assert.equal(pendingTimers.size, 1);
+  pendingTimers.values().next().value();
+  await running;
+
+  assert.equal(firstAttemptSignal.aborted, true);
+  assert.equal(firstAttemptSignal.reason?.code, 'CODEX_STREAM_INACTIVITY_TIMEOUT');
+  assert.equal(runCalls, 2);
+  assert.deepEqual(delays, [30_000]);
+  assert.equal(retryNotices.length, 1);
+  assert.ok(timerDelays.length >= 4);
+  assert.deepEqual(new Set(timerDelays), new Set([5_000]));
+  assert.equal(pendingTimers.size, 0);
+});
