  +import test from 'node:test';
  +import assert from 'node:assert/strict';
  +import { runCodexMessageAttempts } from './message-service.js';
  +import { CodexTurnFailure } from './codex-retry.js';
  +
  +test('keeps one logical stream open across a retry and reuses the thread input', async () => {
  +  const runCalls = [];
  +  const attemptControllers = [];
  +  const retryNotices = [];
  +  let streamStarts = 0;
  +  let streamEnds = 0;
  +  let processCalls = 0;
  +  const runInput = [{ type: 'text', text: 'continue this task' }];
  +  const state = { currentThreadId: 'thread-1' };
  +  const thread = {
  +    async runStreamed(input, options) {
  +      runCalls.push(input);
  +      attemptControllers.push(options.signal);
  +      return { events: { attempt: runCalls.length } };
  +    },
  +  };
  +
  +  await runCodexMessageAttempts({
  +    thread,
  +    runInput,
  +    state,
  +    config: { onTurnCompleted: () => { streamEnds += 1; } },
  +    processEvents: async (events, receivedState, config) => {
  +      processCalls += 1;
  +      assert.equal(receivedState, state);
  +      assert.equal(events.attempt, processCalls);
  +      assert.equal(config.turnAbortController.signal, attemptControllers.at(-1));
  +      if (processCalls === 1) {
  +        throw new CodexTurnFailure('HTTP 503', { status: 503 });
  +      }
  +      config.onTurnCompleted();
  +    },
  +    sleep: async (ms) => assert.equal(ms, 30_000),
  +    onStreamStart: () => { streamStarts += 1; },
  +    onRetry: (notice) => retryNotices.push(notice),
  +  });
  +
  +  assert.equal(runCalls.length, 2);
  +  assert.equal(runCalls[0], runInput);
  +  assert.equal(runCalls[1], runInput);
  +  assert.notEqual(attemptControllers[0], attemptControllers[1]);
  +  assert.equal(streamStarts, 1);
  +  assert.equal(streamEnds, 1);
  +  assert.equal(retryNotices.length, 1);
  +  assert.equal(state.currentThreadId, 'thread-1');
  +});
  +
  +test('retries a transport failure thrown before event processing starts', async () => {
  +  let runCalls = 0;
  +  let processCalls = 0;
  +  let streamStarts = 0;
  +  const thread = {
  +    async runStreamed() {
  +      runCalls += 1;
  +      if (runCalls === 1) throw Object.assign(new Error('fetch failed'), { code: 'ECONNREFUSED' });
  +      return { events: [] };
  +    },
  +  };
  +
  +  await runCodexMessageAttempts({
  +    thread,
  +    runInput: 'retry me',
  +    state: {},
  +    config: {},
  +    processEvents: async () => { processCalls += 1; },
  +    sleep: async () => {},
  +    onStreamStart: () => { streamStarts += 1; },
  +  });
  +
  +  assert.equal(runCalls, 2);
  +  assert.equal(processCalls, 1);
  +  assert.equal(streamStarts, 1);
  +});
