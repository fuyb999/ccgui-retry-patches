+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { runCodexMessageAttempts } from './message-service.js';
+import { CodexTurnFailure } from './codex-retry.js';
+
+async function captureStdout(fn) {
+  const original = process.stdout.write.bind(process.stdout);
+  const captured = [];
+  process.stdout.write = (chunk) => {
+    captured.push(typeof chunk === 'string' ? chunk : chunk.toString());
+    return true;
+  };
+  try {
+    await fn(captured);
+  } finally {
+    process.stdout.write = original;
+  }
+  return captured;
+}
+
+function retryPayloads(captured) {
+  return captured
+    .filter((line) => line.startsWith('[CODEX_RETRY] '))
+    .map((line) => JSON.parse(line.slice('[CODEX_RETRY] '.length)));
+}
+
+test('main send path does not expose raw retry errors through status messages', () => {
+  const source = readFileSync(new URL('./message-service.js', import.meta.url), 'utf8');
+  const sendMessageSource = source.slice(source.indexOf('export async function sendMessage'));
+
+  assert.doesNotMatch(sendMessageSource, /onRetry:\s*\(\{\s*error/);
+  assert.doesNotMatch(sendMessageSource, /Codex request failed \(\$\{reason\}\)/);
+});
+
+test('emits safe scheduled and attempt-started retry lifecycle lines', async () => {
+  const order = [];
+  let attempts = 0;
+  const nestedSecret = 'nested-response-secret';
+  const thread = {
+    async runStreamed() {
+      attempts += 1;
+      order.push(`run:${attempts}`);
+      if (attempts === 1) {
+        throw new CodexTurnFailure('HTTP 503\nAuthorization: Bearer top-secret', {
+          status: 503,
+          response: { body: nestedSecret },
+        });
+      }
+      return { events: [] };
+    },
+  };
+
+  const captured = await captureStdout(async (lines) => {
+    await runCodexMessageAttempts({
+      thread,
+      runInput: 'retry me',
+      state: {},
+      config: {},
+      processEvents: async () => {},
+      now: () => 1_000,
+      sleep: async (delayMs) => {
+        order.push(`sleep:${delayMs}`);
+        const scheduled = retryPayloads(lines).at(-1);
+        assert.equal(scheduled.phase, 'scheduled');
+      },
+      onAttemptStart: ({ retryCount }) => order.push(`callback:${retryCount}`),
+    });
+  });
+
+  const payloads = retryPayloads(captured);
+  assert.deepEqual(payloads, [
+    {
+      phase: 'scheduled',
+      retryCount: 1,
+      delayMs: 30_000,
+      retryAt: 31_000,
+      reason: {
+        category: 'http_5xx',
+        status: 503,
+      },
+    },
+    { phase: 'attempt_started', retryCount: 1 },
+  ]);
+  assert.deepEqual(order, ['run:1', 'sleep:30000', 'callback:1', 'run:2']);
+  assert.equal(captured.join('').includes('top-secret'), false);
+  assert.equal(captured.join('').includes(nestedSecret), false);
+});
+
+test('keeps one logical stream open across a retry and reuses the thread input', async () => {
+  const runCalls = [];
+  const attemptControllers = [];
+  const retryNotices = [];
+  const replayBoundaries = [];
+  let streamStarts = 0;
+  let streamEnds = 0;
+  let processCalls = 0;
+  const runInput = [{ type: 'text', text: 'continue this task' }];
+  const state = { currentThreadId: 'thread-1' };
+  const thread = {
+    async runStreamed(input, options) {
+      runCalls.push(input);
+      attemptControllers.push(options.signal);
+      return { events: { attempt: runCalls.length } };
+    },
+  };
+
+  await runCodexMessageAttempts({
+    thread,
+    runInput,
+    state,
+    config: { onTurnCompleted: () => { streamEnds += 1; } },
+    processEvents: async (events, receivedState, config) => {
+      processCalls += 1;
+      assert.equal(receivedState, state);
+      assert.equal(events.attempt, processCalls);
+      assert.equal(config.turnAbortController.signal, attemptControllers.at(-1));
+      if (processCalls === 1) {
+        throw new CodexTurnFailure('HTTP 503', { status: 503 });
+      }
+      config.onTurnCompleted();
+    },
+    sleep: async (ms) => assert.equal(ms, 30_000),
+    onStreamStart: () => { streamStarts += 1; },
+    onRetry: (notice) => retryNotices.push(notice),
+    prepareReplayBoundary: async (receivedState, threadId) => {
+      assert.equal(receivedState, state);
+      replayBoundaries.push(threadId);
+    },
+  });
+
+  assert.equal(runCalls.length, 2);
+  assert.equal(runCalls[0], runInput);
+  assert.equal(runCalls[1], runInput);
+  assert.notEqual(attemptControllers[0], attemptControllers[1]);
+  assert.equal(streamStarts, 1);
+  assert.equal(streamEnds, 1);
+  assert.equal(retryNotices.length, 1);
+  assert.deepEqual(replayBoundaries, ['thread-1']);
+  assert.equal(state.currentThreadId, 'thread-1');
+});
+
+test('retries a transport failure thrown before event processing starts', async () => {
+  let runCalls = 0;
+  let processCalls = 0;
+  let streamStarts = 0;
+  const thread = {
+    async runStreamed() {
+      runCalls += 1;
+      if (runCalls === 1) throw Object.assign(new Error('fetch failed'), { code: 'ECONNREFUSED' });
+      return { events: [] };
+    },
+  };
+
+  await runCodexMessageAttempts({
+    thread,
+    runInput: 'retry me',
+    state: {},
+    config: {},
+    processEvents: async () => { processCalls += 1; },
+    sleep: async () => {},
+    onStreamStart: () => { streamStarts += 1; },
+  });
+
+  assert.equal(runCalls, 2);
+  assert.equal(processCalls, 1);
+  assert.equal(streamStarts, 1);
+});
