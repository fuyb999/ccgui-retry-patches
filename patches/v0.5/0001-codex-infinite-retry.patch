+
+function withCodexEventInactivityWatchdog(events, options) {
+  if (!events || typeof events[Symbol.asyncIterator] !== 'function') return events;
+
+  return {
+    async *[Symbol.asyncIterator]() {
+      const iterator = events[Symbol.asyncIterator]();
+      try {
+        while (true) {
+          const result = await withCodexInactivityTimeout(iterator.next(), options);
+          if (result.done) return;
+          yield result.value;
+        }
+      } finally {
+        const closing = iterator.return?.();
+        closing?.catch?.(() => {});
+      }
+    },
+  };
+}
+
+function emitCodexRetryState(payload) {
+  process.stdout.write(`[CODEX_RETRY] ${JSON.stringify(payload)}\n`);
+}
+
+export async function runCodexMessageAttempts({
+  thread,
+  runInput,
+  state,
+  config,
+  signal,
+  processEvents = processCodexEventStream,
+  prepareReplayBoundary = prepareSessionReplayBoundary,
+  sleep,
+  inactivityTimeoutMs,
+  inactivityTimers,
+  onStreamStart,
+  onRetry,
+  onAttemptStart,
+  now,
+}) {
+  let streamStarted = false;
+  const resolvedInactivityTimeoutMs = resolveCodexInactivityTimeoutMs(
+    inactivityTimeoutMs ?? process.env.CCGUI_CODEX_INACTIVITY_TIMEOUT_MS,
+  );
+  await runCodexTurnWithRetry({
+    state,
+    signal,
+    sleep,
+    now,
+    onRetry: ({ error, retryCount, delayMs, retryAt, reason }) => {
+      emitCodexRetryState({ phase: 'scheduled', retryCount, delayMs, retryAt, reason });
+      onRetry?.({ error, retryCount, delayMs, retryAt, reason });
+    },
+    onAttemptStart: ({ retryCount }) => {
+      emitCodexRetryState({ phase: 'attempt_started', retryCount });
+      onAttemptStart?.({ retryCount });
+    },
+    runAttempt: async ({ turnAbortController, retryCount }) => {
+      if (retryCount > 0) {
+        await prepareReplayBoundary(state, state.currentThreadId || config.threadId || null);
+      }
+      const { events } = await withCodexInactivityTimeout(
+        thread.runStreamed(runInput, { signal: turnAbortController.signal }),
+        {
+          timeoutMs: resolvedInactivityTimeoutMs,
+          turnAbortController,
+          timers: inactivityTimers,
+        },
+      );
+      if (!streamStarted) {
+        streamStarted = true;
+        onStreamStart?.();
+      }
+      const watchedEvents = withCodexEventInactivityWatchdog(events, {
+        timeoutMs: resolvedInactivityTimeoutMs,
+        turnAbortController,
+        timers: inactivityTimers,
+      });
+      await processEvents(watchedEvents, state, { ...config, turnAbortController });
+    },
+  });
+}
 
