+test('passes a daily usage limit through without emitting retry progress', async () => {
+  let runCalls = 0;
+  const terminalError = new CodexTurnFailure('daily usage limit exceeded', {
+    type: 'turn.failed',
+    error: {
+      status: 429,
+      reason: 'DAYLY\u2014LIMIT\u2014EXCEEDED',
+      message: 'daily usage limit exceeded',
+    },
+  });
+  const thread = {
+    async runStreamed() {
+      runCalls += 1;
+      throw terminalError;
+    },
+  };
+
+  const captured = await captureStdout(async () => {
+    await assert.rejects(
+      runCodexMessageAttempts({
+        thread,
+        runInput: 'stop at the daily limit',
+        state: {},
+        config: {},
+        processEvents: async () => {},
+        sleep: async () => assert.fail('daily limit failure must not sleep'),
+      }),
+      (error) => error === terminalError,
+    );
+  });
+
+  assert.equal(runCalls, 1);
+  assert.deepEqual(retryPayloads(captured), []);
+});
+
+test('retries when the SDK event iterator remains inactive', async () => {
+  const delays = [];
+  const retryNotices = [];
+  const timerDelays = [];
+  const pendingTimers = new Map();
+  let nextTimerId = 1;
+  let runCalls = 0;
+  let firstAttemptSignal;
+  const timers = {
+    setTimeout(callback, delay) {
+      const id = nextTimerId++;
+      timerDelays.push(delay);
+      pendingTimers.set(id, callback);
+      return id;
+    },
+    clearTimeout(id) {
+      pendingTimers.delete(id);
+    },
+  };
+  const thread = {
+    async runStreamed(_input, options) {
+      runCalls += 1;
+      if (runCalls === 1) {
+        firstAttemptSignal = options.signal;
+        return {
+          events: {
+            [Symbol.asyncIterator]() {
+              return {
+                next: () => new Promise((resolve, reject) => {
+                  options.signal.addEventListener('abort', () => reject(options.signal.reason), { once: true });
+                }),
+                return: async () => ({ done: true }),
+              };
+            },
+          },
+        };
+      }
+      return {
+        events: {
+          async *[Symbol.asyncIterator]() {
+            yield { type: 'turn.started' };
+          },
+        },
+      };
+    },
+  };
+
+  const running = runCodexMessageAttempts({
+    thread,
+    runInput: 'retry inactive stream',
+    state: {},
+    config: {},
+    processEvents: async (events) => {
+      for await (const _event of events) {
+        // Consuming the iterable is the behavior under test.
+      }
+    },
+    inactivityTimeoutMs: 5_000,
+    inactivityTimers: timers,
+    sleep: async (ms) => delays.push(ms),
+    onRetry: (notice) => retryNotices.push(notice),
+  });
+
+  await new Promise(setImmediate);
+  assert.equal(runCalls, 1);
+  assert.equal(pendingTimers.size, 1);
+  pendingTimers.values().next().value();
+  await running;
+
+  assert.equal(firstAttemptSignal.aborted, true);
+  assert.equal(firstAttemptSignal.reason?.code, 'CODEX_STREAM_INACTIVITY_TIMEOUT');
+  assert.equal(runCalls, 2);
+  assert.deepEqual(delays, [30_000]);
+  assert.equal(retryNotices.length, 1);
+  assert.ok(timerDelays.length >= 4);
+  assert.deepEqual(new Set(timerDelays), new Set([5_000]));
+  assert.equal(pendingTimers.size, 0);
+});
