+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  CODEX_RETRY_DELAY_MS,
+  CodexTurnFailure,
+  abortableDelay,
+  isRetryableCodexError,
+  runCodexTurnWithRetry,
+} from './codex-retry.js';
+
+test('classifies capacity, rate limit, server, and transport failures as retryable', () => {
+  const retryable = [
+    { status: 429 },
+    { statusCode: 500 },
+    { status: 502 },
+    { response: { status: 503 } },
+    { httpStatus: 599 },
+    { code: 'model_at_capacity' },
+    new Error('Selected model is at capacity. Please try a different model.'),
+    new Error('429 Too Many Requests'),
+    new Error('429'),
+    new Error('502'),
+    Object.assign(new Error('fetch failed'), { code: 'ECONNRESET' }),
+    new Error('socket closed before the response completed'),
+    new CodexTurnFailure('stream failed', { error: { code: 'ETIMEDOUT' } }),
+  ];
+
+  for (const error of retryable) {
+    assert.equal(isRetryableCodexError(error), true, JSON.stringify(error));
+  }
+});
+
+test('keeps client and authentication failures terminal', () => {
+  for (const status of [400, 401, 403]) {
+    assert.equal(isRetryableCodexError({ status }), false);
+    assert.equal(isRetryableCodexError(new Error(`HTTP ${status}`)), false);
+    assert.equal(
+      isRetryableCodexError({ message: 'fetch failed', response: { status } }),
+      false,
+      `HTTP ${status} must take precedence over transport text`,
+    );
+  }
+  assert.equal(isRetryableCodexError(new Error('invalid request')), false);
+  assert.equal(isRetryableCodexError({ status: 404 }), false);
+});
+
+test('uses a fixed 30 second abortable delay', async () => {
+  assert.equal(CODEX_RETRY_DELAY_MS, 30_000);
+
+  let requestedDelay = null;
+  let completeTimer;
+  const timers = {
+    setTimeout(callback, delay) {
+      requestedDelay = delay;
+      completeTimer = callback;
+      return 17;
+    },
+    clearTimeout() {},
+  };
+
+  const waiting = abortableDelay(CODEX_RETRY_DELAY_MS, undefined, timers);
+  assert.equal(requestedDelay, 30_000);
+  completeTimer();
+  await waiting;
+});
+
+test('cancels a pending retry delay', async () => {
+  const controller = new AbortController();
+  let clearedTimer = null;
+  const timers = {
+    setTimeout() { return 23; },
+    clearTimeout(timer) { clearedTimer = timer; },
+  };
+
+  const waiting = abortableDelay(CODEX_RETRY_DELAY_MS, controller.signal, timers);
+  controller.abort();
+
+  await assert.rejects(waiting, (error) => error?.name === 'AbortError');
+  assert.equal(clearedTimer, 23);
+});
+
+test('retries without a maximum attempt count at a fixed delay', async () => {
+  const failures = [429, 500, 502, 503, 599, 429, 502];
+  const delays = [];
+  const controllers = [];
+  const retryNotices = [];
+  const state = { turnStarted: true, turnCompleted: true, currentThreadId: 'thread-1' };
+
+  const result = await runCodexTurnWithRetry({
+    state,
+    runAttempt: async ({ turnAbortController }) => {
+      controllers.push(turnAbortController);
+      const status = failures.shift();
+      if (status) throw new CodexTurnFailure(`HTTP ${status}`, { status });
+      return 'done';
+    },
+    sleep: async (ms) => { delays.push(ms); },
+    onRetry: (notice) => retryNotices.push(notice),
+  });
+
+  assert.equal(result, 'done');
+  assert.deepEqual(delays, Array(7).fill(30_000));
+  assert.equal(retryNotices.length, 7);
+  assert.equal(new Set(controllers).size, 8);
+  assert.equal(state.currentThreadId, 'thread-1');
+});
+
+test('does not retry HTTP 400, 401, or 403', async () => {
+  for (const status of [400, 401, 403]) {
+    let attempts = 0;
+    await assert.rejects(
+      runCodexTurnWithRetry({
+        state: {},
+        runAttempt: async () => {
+          attempts += 1;
+          throw new CodexTurnFailure(`HTTP ${status}`, { status });
+        },
+        sleep: async () => assert.fail('terminal failure must not sleep'),
+      }),
+      (error) => error.details.status === status,
+    );
+    assert.equal(attempts, 1);
+  }
+});
+
+test('resets attempt-local flags while preserving logical output state', async () => {
+  const emittedToolUseIds = new Set(['tool-1']);
+  const state = {
+    turnStarted: true,
+    turnCompleted: true,
+    turnUsageBaseline: { input_tokens: 10 },
+    latestTotalTokenUsage: { input_tokens: 20 },
+    commandApprovalAbortRequested: false,
+    currentThreadId: 'thread-preserved',
+    assistantText: 'partial output',
+    emittedToolUseIds,
+  };
+  let attempts = 0;
+
+  await runCodexTurnWithRetry({
+    state,
+    runAttempt: async () => {
+      attempts += 1;
+      if (attempts === 1) throw new Error('socket hang up');
+      assert.equal(state.turnStarted, false);
+      assert.equal(state.turnCompleted, false);
+      assert.equal(state.turnUsageBaseline, null);
+      assert.equal(state.latestTotalTokenUsage, null);
+      assert.equal(state.currentThreadId, 'thread-preserved');
+      assert.equal(state.assistantText, 'partial output');
+      assert.equal(state.emittedToolUseIds, emittedToolUseIds);
+    },
+    sleep: async () => {},
+  });
+});
+
+test('cancels while waiting for the next attempt', async () => {
+  const controller = new AbortController();
+  let attempts = 0;
+
+  await assert.rejects(
+    runCodexTurnWithRetry({
+      state: {},
+      signal: controller.signal,
+      runAttempt: async () => {
+        attempts += 1;
+        throw new Error('network error');
+      },
+      onRetry: () => controller.abort(),
+    }),
+    (error) => error?.name === 'AbortError',
+  );
+  assert.equal(attempts, 1);
+});
+
+test('cancels the active attempt and never retries cancellation', async () => {
+  const controller = new AbortController();
+  let attempts = 0;
+
+  const running = runCodexTurnWithRetry({
+    state: {},
+    signal: controller.signal,
+    runAttempt: ({ turnAbortController }) => new Promise((resolve, reject) => {
+      attempts += 1;
+      turnAbortController.signal.addEventListener('abort', () => {
+        const error = new Error('active turn aborted');
+        error.name = 'AbortError';
+        reject(error);
+      }, { once: true });
+    }),
+  });
+  controller.abort();
+
+  await assert.rejects(running, (error) => error?.name === 'AbortError');
+  assert.equal(attempts, 1);
+});
