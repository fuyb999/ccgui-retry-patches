  +  runCodexTurnWithRetry,
  +} from './codex-retry.js';
  +
  +test('classifies capacity, rate limit, server, and transport failures as retryable', () => {
  +  const retryable = [
  +    { status: 429 },
  +    { statusCode: 500 },
  +    { status: 502 },
  +    { response: { status: 503 } },
  +    { httpStatus: 599 },
  +    { code: 'model_at_capacity' },
  +    new Error('Selected model is at capacity. Please try a different model.'),
  +    new Error('429 Too Many Requests'),
  +    new Error('429'),
  +    new Error('502'),
  +    Object.assign(new Error('fetch failed'), { code: 'ECONNRESET' }),
  +    new Error('socket closed before the response completed'),
  +    new CodexTurnFailure('stream failed', { error: { code: 'ETIMEDOUT' } }),
  +  ];
  +
  +  for (const error of retryable) {
  +    assert.equal(isRetryableCodexError(error), true, JSON.stringify(error));
  +  }
  +});
  +
  +test('keeps client and authentication failures terminal', () => {
  +  for (const status of [400, 401, 403]) {
  +    assert.equal(isRetryableCodexError({ status }), false);
  +    assert.equal(isRetryableCodexError(new Error(`HTTP ${status}`)), false);
  +    assert.equal(
  +      isRetryableCodexError({ message: 'fetch failed', response: { status } }),
  +      false,
  +      `HTTP ${status} must take precedence over transport text`,
  +    );
  +  }
  +  assert.equal(isRetryableCodexError(new Error('invalid request')), false);
  +  assert.equal(isRetryableCodexError({ status: 404 }), false);
